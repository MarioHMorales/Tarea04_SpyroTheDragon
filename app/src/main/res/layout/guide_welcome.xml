<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guideWelcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_spyro"
    android:clickable="true"
    android:focusable="true">

    <!-- BOTÓN SKIP -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/skip_guide"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TARJETA CENTRAL -->

    <!-- BOTÓN COMENZAR (más visual) -->

    <LinearLayout
        android:id="@+id/cardWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_bubble"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnBegin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.855">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/ivLogoSpyro"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/spyro_logo" />

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvTittle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/text_welcome_tittle"
            android:textColor="#4E1A70"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- DESCRIPCIÓN -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/text_welcome2"
            android:textColor="#6A2C91"
            android:textSize="16sp" />

        <!-- INSTRUCCIÓN -->
        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#803E1A5F"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/text_welcome"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btnBegin"
        android:layout_width="180dp"
        android:layout_height="120dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/gems"
            android:scaleType="fitXY"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/begin"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:shadowColor="#4E1A70"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>