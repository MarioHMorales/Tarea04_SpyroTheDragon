<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <!-- FLECHA -->
    <ImageView
        android:id="@+id/arrowGuide"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/arrow_up_float"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#E8C15C" />

    <!-- BOCADILLO -->
    <LinearLayout
        android:id="@+id/bubbleInfo"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_bubble"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/arrowGuide">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aquí puedes ver información sobre la aplicación"
            android:textColor="#4E1A70"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFinish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:clickable="true"
            android:text="Finalizar"
            android:textColor="#E8C15C" />
    </LinearLayout>

    <!-- SKIP -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#66000000"
        android:clickable="true"
        android:text="@string/skip_guide"
        android:textColor="#FFFFFF"

        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/bubbleInfo"
        app:layout_constraintTop_toBottomOf="@id/bubbleInfo" />

</androidx.constraintlayout.widget.ConstraintLayout>